version: 5.1.0
type: update
id: rapyd-enable-remote-db
name: Rapyd2 - Enable Remote MariaDB with SSL
logo: icon.png

description:
  short: Enable remote MariaDB with SSL 

categories:
- apps/dev-and-admin-tools

targetNodes:
  nodeType:
  - llsmp
  - levamo-lomp

onInstall:
  - action: enableRemoteSSL

onAfterRedeployContainer:
  action: enableRemoteSSL

onUninstall:
  action: cleanup

onAfterRestartNode:
  action: addPortForwarding
  
onAfterStart:
  action: addPortForwarding

actions:
  addPortForwarding:
    - cmd[${targetNodes.nodeGroup}]: |-

        nftFile="/etc/nftables/user-defined.nft"
        natRule='add rule ip nat PREROUTING tcp dport 8823 counter packets 0 bytes 0 redirect to :3306 comment "rapyd-enable-remote-db"'
        filterRule='add rule ip filter INPUT tcp dport 3306 counter packets 0 bytes 0 accept comment "rapyd-enable-remote-db"'

        mkdir -p "$(dirname "$nftFile")"
        touch "$nftFile"

        # Persist the rules so they are reloaded automatically when the firewall restarts
        grep -q "dport 8823" "$nftFile" || echo "$natRule" >> "$nftFile"
        grep -q "dport 3306" "$nftFile" || echo "$filterRule" >> "$nftFile"

        # Reload the firewall so the persisted rules are applied immediately too
        sudo /usr/bin/jem firewall fwstart

      user: root

  enableRemoteSSL:
    - cmd[${targetNodes.nodeGroup}]: |-

        sshFolder="/var/www/webroot/db-remote-ssl/"
        # Enable remote MariaDB and SSL
        # Bind MariaDB to 0.0.0.0
        if grep -q '^bind-address' /etc/my.cnf; then
        sed -i 's/^bind-address.*/bind-address=0.0.0.0/' /etc/my.cnf
        else
        echo "bind-address=0.0.0.0" >> /etc/my.cnf
        fi
        # Create SSL directory
        mkdir -p $sshFolder
        # Generate server key and certificate if not exist
        [ -f $sshFolder/server-key.pem ] || openssl genrsa 2048 > $sshFolder/server-key.pem
        [ -f $sshFolder/server-cert.pem ] || openssl req -new -x509 -nodes -days 3650 \
        -key $sshFolder/server-key.pem \
        -out $sshFolder/server-cert.pem \
        -subj "/CN=$(hostname)/O=MyOrg"
        [ -f $sshFolder/ca-cert.pem ] || cp $sshFolder/server-cert.pem $sshFolder/ca-cert.pem
        
        # Add SSL configuration in my.cnf if not present
        rm -f /etc/mysql/conf.d/rapyd-ssl.cnf;
        echo "[mysqld]" > /etc/mysql/conf.d/rapyd-ssl.cnf
        echo "ssl=ON" >> /etc/mysql/conf.d/rapyd-ssl.cnf
        echo "ssl-ca=$sshFolder/ca-cert.pem" >> /etc/mysql/conf.d/rapyd-ssl.cnf
        echo "ssl-cert=$sshFolder/server-cert.pem" >> /etc/mysql/conf.d/rapyd-ssl.cnf
        echo "ssl-key=$sshFolder/server-key.pem" >> /etc/mysql/conf.d/rapyd-ssl.cnf

        # Restart MariaDB
        systemctl restart mariadb

      user: root

    - addPortForwarding
    
  cleanup: 
    - cmd[${targetNodes.nodeGroup}]: |-

        # Disable remote MariaDB SSL (restore original state)
        rm -f /etc/mysql/conf.d/rapyd-ssl.cnf;
        sed -i 's/^bind-address.*/bind-address=127.0.0.1/' /etc/my.cnf
        # Restart MariaDB
        systemctl restart mariadb

        # Remove only the nftables rules added by this plugin, identified by their comment tag
        tag="rapyd-enable-remote-db"
        nftFile="/etc/nftables/user-defined.nft"

        [ -f "$nftFile" ] && sed -i "/comment \"$tag\"/d" "$nftFile"

        # Reload the firewall so the removal takes effect immediately too
        sudo /usr/bin/jem firewall fwstart

      user: root